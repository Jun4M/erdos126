    given-names: Junho
    orcid: "https://orcid.org/0009-0008-1540-7694"
    affiliation: "Kyung Hee University"
license: MIT
repository-code: "https://github.com/Jun4M/erdos126"
keywords:
  - number theory
  - Erdos problems
  - smooth numbers
  - S-unit equations
  - integer sequences
